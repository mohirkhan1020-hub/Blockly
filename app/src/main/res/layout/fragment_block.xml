<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_dark"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Block" android:textColor="@color/text_primary"
            android:textSize="26sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="RULES" android:textColor="@color/text_secondary"
            android:textSize="11sp" android:layout_marginTop="16dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/card_dark" app:cardCornerRadius="16dp">
            <TextView android:text="Focus Profiles" android:padding="20dp"
                android:textColor="@color/text_primary" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/card_dark" app:cardCornerRadius="16dp">
            <TextView android:text="Manage Apps" android:padding="20dp"
                android:textColor="@color/text_primary" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:orientation="vertical" android:padding="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <TextView android:id="@+id/tvGreeting" android:text="Good Afternoon"
            android:textColor="@color/text_secondary"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Blocklyn" android:textColor="@color/text_primary"
            android:textSize="26sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_dark" app:cardCornerRadius="20dp">
            <LinearLayout android:orientation="horizontal" android:padding="20dp"
                android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/circularProgress"
                    android:layout_width="90dp" android:layout_height="90dp"
                    android:indeterminate="false" android:max="100" android:progress="37"
                    app:indicatorColor="@color/accent_blue"
                    app:trackColor="@color/card_dark_alt"
                    app:trackThickness="8dp"/>
                <LinearLayout android:orientation="vertical" android:layout_marginStart="20dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:text="TODAY'S APP USAGE" android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvTodayUsage" android:text="2.3h"
                        android:textColor="@color/text_primary" android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvGoalStatus" android:text="On track · 37%"
                        android:textColor="@color/accent_green" android:textSize="12sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:text="Hourly Usage" android:textColor="@color/text_primary"
            android:textStyle="bold" android:layout_marginTop="20dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/hourlyChart"
            android:layout_width="match_parent" android:layout_height="200dp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>

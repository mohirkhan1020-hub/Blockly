<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:background="@color/bg_dark" android:padding="20dp"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <FrameLayout android:layout_width="280dp" android:layout_height="280dp"
        android:layout_marginTop="60dp">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/focusProgress"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:indeterminate="false" android:max="100" android:progress="100"
            app:indicatorSize="280dp" app:trackThickness="14dp"
            app:indicatorColor="@color/accent_blue"
            app:trackColor="@color/card_dark_alt"/>
        <LinearLayout android:orientation="vertical" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView android:id="@+id/tvTimer" android:text="25:00"
                android:textColor="@color/text_primary" android:textSize="48sp"
                android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="remaining" android:textColor="@color/text_secondary"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPause" android:text="Pause"
        android:layout_marginTop="60dp"
        android:layout_width="match_parent" android:layout_height="56dp"
        app:backgroundTint="@color/accent_blue"
        app:cornerRadius="28dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnd" android:text="Hold to end session"
        android:layout_marginTop="12dp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="56dp"
        app:cornerRadius="28dp"/>
</LinearLayout>
